# Set optional runtime variables in the shell that launches Electron.
# Jarvis does not load this file.
# The dev runner obtains the renderer URL directly from the Vite server.
# JARVIS_OLLAMA_EXECUTABLE=C:\path\to\ollama.exe
# JARVIS_OLLAMA_MODEL=llama3.2
# JARVIS_N8N_EXECUTABLE=C:\path\to\n8n.cmd
# JARVIS_N8N_PORT=5678
# JARVIS_N8N_WEBHOOK_SECRET_FILE=C:\path\outside\checkout\jarvis-webhook-token.txt
